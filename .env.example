# AI provider: claude | openclaw  (default: claude)
AI_PROVIDER=claude

# --- claude CLI provider (used when AI_PROVIDER=claude) ---
# Uses your local `claude` CLI's pre-configured base_url / api_key / model.
# Do NOT set those here; configure them via `claude` itself (login / config).
# CLAUDE_BIN_PATH=claude
# CLAUDE_TIMEOUT_MS=120000

# --- OpenClaw provider (used when AI_PROVIDER=openclaw) ---
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_TOKEN=replace-with-your-token
OPENCLAW_MODEL=openclaw:json-agent
